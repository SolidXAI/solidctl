# =============================================================================
# Solid API environment reference
# =============================================================================
# `solidctl create-app` generates the required `.env` values.
# Uncomment and copy optional lines only when needed. Never commit real secrets.
#
# Format: ENV_VAR=example_value  # What the variable controls

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENV=dev                                      # Runtime: dev, test, or production.
PORT=3000                                    # Port on which the API listens.
SOLID_APP_NAME="My Solid App"                # Application name displayed by Solid.
# SOLID_APP_SUBTITLE=                        # Optional subtitle displayed with the app name.
# SOLID_APP_DESCRIPTION=                     # Optional app and API-documentation description.
BASE_URL=http://localhost:3000               # Public URL of the API.
FRONTEND_BASE_URL=http://localhost:3001      # Public URL of the frontend.
# LOG_LEVEL=info                             # Logging level: debug, info, warn, or error.
# SECURITY_CORS_ORIGINS=http://localhost:3001 # Comma-separated origins allowed to call the API.
# APP_ENCRYPTION_KEY=replace_me              # Secret used to encrypt stored sensitive settings.

# -----------------------------------------------------------------------------
# Default database
# -----------------------------------------------------------------------------
DEFAULT_DATABASE_TYPE=postgres               # Database engine: postgres, mysql, or mssql.
DEFAULT_DATABASE_HOST=localhost              # Database server hostname or IP address.
DEFAULT_DATABASE_PORT=5432                   # Database server port.
DEFAULT_DATABASE_USER=solidx_app_user        # Database login username.
DEFAULT_DATABASE_PASSWORD=replace_me         # Database login password.
DEFAULT_DATABASE_NAME=solidx_app_db          # Default application database name.
DEFAULT_DATABASE_SYNCHRONIZE=false           # Auto-update schema; avoid in production.
DEFAULT_DATABASE_LOGGING=false               # Enable TypeORM database logging.
# DEFAULT_DATABASE_POOL_MAX=20               # Maximum database pool connections.
# DEFAULT_DATABASE_RETRY_ATTEMPTS=0          # Initial connection retry count.
# DEFAULT_DATABASE_RETRY_DELAY_MS=0          # Delay between retries in milliseconds.

# -----------------------------------------------------------------------------
# Authentication and JWT
# -----------------------------------------------------------------------------
IAM_PASSWORD_LESS_REGISTRATION=false         # Allow registration without a password.
IAM_PASSWORD_LESS_REGISTRATION_VALIDATE_WHAT=transactional # Passwordless value to verify.
IAM_ALLOW_PUBLIC_REGISTRATION=true           # Allow visitors to create accounts.
IAM_ACTIVATE_USER_ON_REGISTRATION=true       # Activate new users immediately.
IAM_DEFAULT_ROLE=Admin                       # Role assigned to new users.
IAM_JWT_TOKEN_AUDIENCE=http://localhost:3000 # Expected JWT audience claim.
IAM_JWT_TOKEN_ISSUER=my-solid-app            # JWT issuer claim.
IAM_JWT_SECRET=replace_me                    # Secret used to sign authentication tokens.
# IAM_JWT_ACCESS_TOKEN_TTL=86400             # Access-token lifetime in seconds.
# IAM_JWT_REFRESH_TOKEN_TTL=604800           # Refresh-token lifetime in seconds.

# -----------------------------------------------------------------------------
# Google OAuth (optional)
# -----------------------------------------------------------------------------
# IAM_GOOGLE_OAUTH_CLIENT_ID=                # Client ID from Google Cloud.
# IAM_GOOGLE_OAUTH_CLIENT_SECRET=            # Client secret from Google Cloud.
# IAM_GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback # Registered API callback.
# IAM_GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3001 # Frontend redirect after login.

# -----------------------------------------------------------------------------
# File storage (optional)
# -----------------------------------------------------------------------------
# DEFAULT_FILE_SERVICE=disk                  # Storage provider: disk or s3.
# AB_MEDIA_UPLOAD_DIR=uploads                # Temporary upload directory.
# AB_MEDIA_FILE_STORAGE_ROOT=.               # Root path for local media storage.
# AB_MEDIA_FILE_STORAGE_DIR=uploads          # Media directory below the storage root.
# AB_MEDIA_MAX_FILE_SIZE_MB=10               # Maximum upload size in megabytes.
# S3_AWS_ACCESS_KEY=                         # AWS access-key ID for S3.
# S3_AWS_SECRET_KEY=                         # AWS secret access key for S3.
# S3_AWS_REGION_NAME=ap-south-1              # AWS region containing the bucket.
# S3_DEFAULT_BUCKET=                         # Default S3 bucket for uploads.

# -----------------------------------------------------------------------------
# SMTP email (optional)
# -----------------------------------------------------------------------------
# COMMON_EMAIL_PROVIDER=SMTPEMailService     # Email service implementation.
# COMMON_EMAIL_FROM=no-reply@example.com     # Default From address.
# COMMON_EMAIL_SHOULD_QUEUE=false            # Queue email instead of sending immediately.
# COMMON_SMTP_EMAIL_SMTP_HOST=smtp.example.com # SMTP server hostname.
# COMMON_SMTP_EMAIL_SMTP_PORT=587            # SMTP server port.
# COMMON_SMTP_EMAIL_USERNAME=                # SMTP authentication username.
# COMMON_SMTP_EMAIL_PASSWORD=                # SMTP authentication password.
# COMMON_SMTP_EMAIL_FROM=no-reply@example.com # SMTP-specific From address.

# -----------------------------------------------------------------------------
# Queues and scheduler (optional)
# -----------------------------------------------------------------------------
# QUEUES_DEFAULT_BROKER=database             # Queue backend: database, redis, or rabbitmq.
# QUEUES_REDIS_URL=redis://localhost:6379    # Redis connection URL.
# QUEUES_RABBIT_MQ_URL=amqp://guest:guest@localhost:5672 # RabbitMQ connection URL.
# SOLID_SCHEDULER_ENABLED=true               # Enable scheduled jobs.
# SOLID_SCHEDULER_JOBS_REGEX_TO_ENABLE=      # Regex limiting which jobs may run.

# -----------------------------------------------------------------------------
# MCP and agents (optional)
# -----------------------------------------------------------------------------
# MCP_ENABLED=false                          # Enable Model Context Protocol integration.
# MCP_SERVER_URL=http://localhost:8000       # MCP server URL.
# MCP_API_KEY=                               # MCP server authentication key.
# SOLIDX_AGENT_ENABLED=false                 # Enable the SolidX AI agent.
# SOLIDX_AGENT_BACKEND_URL=http://localhost:8765 # SolidX agent backend URL.
# AGENT_HUB_ENABLED=false                    # Enable Agent Hub.
# AGENT_HUB_BACKEND_URL=                     # Agent Hub backend URL.

