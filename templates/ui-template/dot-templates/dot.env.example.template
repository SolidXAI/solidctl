# =============================================================================
# Solid UI environment reference
# =============================================================================
# VITE_* values are exposed to browser code. Never store secrets in them.
#
# Format: ENV_VAR=example_value  # What the variable controls

# API
VITE_BACKEND_API_URL=http://localhost:3000   # Backend URL used for API requests.
VITE_API_URL=http://localhost:3000           # Legacy API URL used by some components.
# VITE_BACKEND_RETRY_DELAY_MS=1500           # Delay between backend health retries.
# VITE_BACKEND_UNAVAILABLE_TOAST_DELAY_MS=60000 # Delay before showing the unavailable notice.
# VITE_REVALIDATE_TOKEN=                     # Legacy public revalidation token; not a secret.

# Application
VITE_SOLIDX_ENV=dev                          # Runtime: dev, test, or production.
VITE_SOLID_APP_TITLE="My Solid App"          # Application title displayed in the UI.
VITE_SOLID_APP_DESCRIPTION=                  # Optional short application description.
# VITE_LOGIN_REDIRECT_URL=/admin             # Page opened after successful authentication.
# VITE_DEFAULT_MENU_KEY=                     # Menu selected by default after login.
# VITE_DEFAULT_LIST_VIEW_NODATA_HELPER_TEXT=  # Prefix shown when a list has no records.
# VITE_SOLIDX_ON_APPLICATION_MOUNT_HANDLER=  # Named handler invoked when the app mounts.

# Authentication UI
# VITE_PASSWORD_REGEX=                       # Password-validation regular expression.
# VITE_PASSWORD_COMPLEXITY_DESC=             # Password requirements shown to users.
# VITE_RESEND_OTP_TIMER=0.5                  # Delay in minutes before OTP can be resent.

# AI Studio
# VITE_SOLIDX_AI_URL=http://localhost:8765   # URL opened for SolidX AI features.

